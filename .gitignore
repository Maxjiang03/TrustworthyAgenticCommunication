# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Virtual environments
.venv/
venv/

# Secrets / local environment — never commit credentials (PROJECT_RULES.md red line 8)
.env
.env.*

# uv cache (if redirected into the project)
.uv-cache/
.uv_cache/

# OS noise
.DS_Store
Thumbs.db

# Generated experiment outputs: ignore contents, keep the tree placeholders
# tracked. Raw traces are added deliberately at campaign time (write-once,
# design Part J.4) via an explicit .gitignore change, never by accident.
results/**
!results/**/
!results/**/.gitkeep
# THE CONFIRMATORY CAMPAIGN RAN 2026-08-07, and Part H step 7's "once" is spent.
# §J.4 item 14: raw traces are immutable and archived. These three paths are
# admitted DELIBERATELY, which is what the rule above exists to require -- a
# raw trace must never be committed by accident, and must never be absent by
# accident either. Committing them puts them in history, where they cannot be
# edited without rewriting it.
!results/raw/campaign-confirmatory.json
!results/tables/results-confirmatory.json
!results/tables/results-latency-pilot.json
!results/tables/results-latency-pilot-run2.json
!results/tables/results-latency-pilot-rq4.json
!results/tables/results-latency-pilot-rq4-run2.json
!results/tables/results-confirmatory.md
# RQ4's latency pass, 2026-08-07 (ADR 0047). Raw per-repetition values, so a
# Sighting C stall is locatable rather than absorbed into a summary; admitted
# deliberately for the same reason as the campaign trace above.
!results/raw/latency-pilot.json
smoke/g10/_ledger_tmp/

# Working-tree copies of task specifications the Commander issues at the
# repository root. Every one of them is already archived byte-for-byte under
# docs/tasks/archive/ or docs/workplan/archive/, so these are redundant
# copies, NOT the record -- deleting them is not this repository's call
# (HANDOFF.md §2), but leaving them untracked is not free either:
# src/harness/campaign.py stamps `git_dirty: true` on every run record from
# `git status --porcelain`, so an untracked leftover would mark the one
# confirmatory campaign's provenance dirty for a reason unrelated to the
# experiment. Ignored, so the tree is clean and the files stay.
/*_TASK.md
/TASK_*.md
/HANDOFF.md
